# Copy to .env.local and fill in. The app runs WITHOUT these using a
# rule-based fallback, but real Bedrock reasoning needs AWS credentials.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Option A: static credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Option B: use a named profile instead of the keys above
# AWS_PROFILE=hackathon
