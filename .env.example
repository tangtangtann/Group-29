# Copy to .env.local and fill in. The app runs WITHOUT these using a
# rule-based fallback, but real Bedrock reasoning needs AWS credentials.
# Never commit .env.local.

BEDROCK_REGION=us-east-1
# Must be enabled in your account. Check Bedrock console → Model catalog.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local dev: temporary credentials from your AWS access portal
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Or use a named profile instead of the keys above
# AWS_PROFILE=hackathon

# Hosted (Amplify/Lambda with an IAM role, no keys): set this instead
# BEDROCK_ENABLED=true
